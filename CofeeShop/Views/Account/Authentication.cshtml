@model CoffeeShop.Core.DTOs.Account.AuthenticationViewModel

@{
    ViewData["Title"] = "ورود / ثبت نام";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود و ثبت‌نام | اقامت یاب</title>
    <link rel="stylesheet" href="~/css/login-style.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all-fonts.min.css" />
</head>

<body>
    <!-- BACK TO HOME -->
    <a asp-controller="Home" asp-action="Index" class="back-btn" title="بازگشت به صفحه اصلی">
        <i class="fas fa-arrow-right"></i>
        <span>بازگشت به صفحه اصلی</span>
    </a>
    <!-- FORM CONTAINER -->
    <div class="form-container">
        <h2 class="form-title">فرم ورود</h2>
        <!-- buttons -->
        <div class="header-buttons">
            <button type="button" class="header-btn login-btn active">ورود</button>
            <button type="button" class="header-btn register-btn">ثبت‌نام</button>
        </div>
        <!-- forms -->
        <div class="form-wrapper">
            <!--------- LOGIN FORM --------->
            <partial name="_LoginForm" model="Model.Login" />

            <!--------- REGISTER FORM --------->
            <partial name="_RegisterForm" model="Model.Register" />

        </div>
    </div>

    <!-- SCRIPT -->
    <script src="~/js/login-script.js"></script>
</body>
</html>
