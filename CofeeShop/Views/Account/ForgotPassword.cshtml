@model ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "بازیابی رمز عبور";
}

@{
    if (Model != null && !string.IsNullOrEmpty(Model.Status))
    {
        <div class="alert alert-@(Model?.Status == "Success"? "success" : "danger")" role="alert">
            @Model?.ResultMessage
        </div>
    }
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> فراموشی رمز عبور | اقامت یاب </title>
    <link rel="stylesheet" href="~/css/login-style.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all-fonts.min.css" />
</head>

<body>
<!-- BACK TO HOME -->
<a asp-controller="Home" asp-action="Index" class="back-btn" title="بازگشت به صفحه اصلی">
    <i class="fas fa-arrow-right"></i>
    <span>بازگشت به صفحه اصلی</span>
</a>
<!-- FORM CONTAINER -->
<div class="form-container">
    <h2 class="form-title">فراموشی رمز عبور</h2>
    <div class="form-wrapper">
        <form asp-action="ForgotPassword" method="post" class="form active">
            <input
                type="text"
                asp-for="Email"
                autocomplete="off"
                class="form-input"
                id="forget-email-input"
                placeholder="آدرس ایمیل"
            />
            <button type="submit" class="form-btn">تایید</button>
        </form>
    </div>
</div>

<!-- SCRIPT -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/js/login-script.js"></script>
    }
}
</body>
</html>

