@model AllResidencesViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>رزرو اقامتگاه - همه اقامتگاه‌ها</title>
    <link rel="stylesheet" href="~/css/allaccommodation.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all-fonts.min.css" />
</head>
<body>
    <!-- Header Section -->
    <header class="header" id="header">
        <div class="container">
            <div class="header-content">
                <!-- Logo -->
                <div class="logo">
                    <h1>اقامت یاب</h1>
                </div>

                <!-- Desktop Navigation -->
                <nav class="nav-menu" id="navMenu">
                    <ul>
                        <li><a href="/Home" class="active">خانه</a></li>
                        <li><a href="/ContactUs">تماس با ما</a></li>
                    </ul>
                </nav>

                <!-- Auth Buttons -->
                <div class="auth-buttons" id="authButtons">
                    <form asp-action="Index" method="get">
                        <div class="input-wrapper">
                            <input class="input-all"
                                   type="text"
                                   name="search"
                                   autocomplete="off"
                                   placeholder="جستجو" />
                            <i class="fas fa-search"></i>
                        </div>
                    </form>
                </div>
                <!-- Mobile Menu Toggle -->
                <button class="mobile-menu-toggle" id="mobileMenuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Accommodations Listing Section -->
    <section class="accommodations" id="accommodations">
        <div class="container">
            <h2 class="section-title">همه اقامتگاه ها</h2>
            <div class="accommodations-grid" id="accommodationsGrid">
                <partial name="_BoxResidenceView" model="@((Residences: Model.ResidenceBoxDetail, Category: "accommodation"))" />
            </div>
            <form asp-controller="Residence" asp-action="Index" method="get">
                @for (int i = 0; i < Model.CountPage; i++)
                {
                    <button type="submit" name="page" value="@i"
                            class="pagination-btn @(i == int.Parse(ViewData["CurrentPage"].ToString()) ? "active" : "")">
                        @(i + 1)
                    </button>
                }
                <input hidden="true" name="search" value="@ViewData["Search"]" />
            </form>
            <div id="paginationContainer" class="pagination-container"></div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <!-- About Column -->
                <div class="footer-column">
                    <h3>درباره ما</h3>
                    <p>
                        اقامت یاب بزرگترین پلتفرم رزرو اقامتگاه در ایران است. ما به شما
                        کمک می‌کنیم بهترین اقامتگاه را برای سفر خود پیدا کنید.
                    </p>
                </div>

                <!-- Links Column -->
                <div class="footer-column">
                    <h3>لینک‌های مفید</h3>
                    <ul>
                        <li><a href="#">درباره ما</a></li>
                        <li><a href="#">تماس با ما</a></li>
                        <li><a href="#">قوانین و مقررات</a></li>
                        <li><a href="#">حریم خصوصی</a></li>
                    </ul>
                </div>

                <!-- Support Column -->
                <div class="footer-column">
                    <h3>پشتیبانی</h3>
                    <ul>
                        <li><a href="#">راهنمای رزرو</a></li>
                        <li><a href="#">سوالات متداول</a></li>
                        <li><a href="#">میزبان شوید</a></li>
                        <li><a href="#">تماس با پشتیبانی</a></li>
                    </ul>
                </div>

                <!-- Social Media Column -->
                <div class="footer-column">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="social-icons">
                        <a href="instagram.com" class="social-icon">
                            <img src="/public/outline-instagram-logo_svgstack_com_4721767299818.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="twitter.com" class="social-icon">
                            <img src="/public/outline-x-vector-logo_svgstack_com_5671767299843.svg"
                                 alt="twitter"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="facebook.com" class="social-icon">
                            <img src="/public/facebook-icon_svgstack_com_5631767299831.svg"
                                 alt="facebook"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="linkdin.com" class="social-icon">
                            <img src="/public/linkedin-logo-icon_svgstack_com_3961767299854.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="footer-bottom">
                <p>Copyright © 2023 Aghamtgah Yab. All rights reserved</p>
            </div>
        </div>
    </footer>

    <!-- SCRIPT -->
    <script src="~/js/allaccommodation.js"></script>
</body>
</html>
