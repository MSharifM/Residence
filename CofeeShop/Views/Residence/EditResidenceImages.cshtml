@model EditResidenceImagesViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ویرایش عکس‌های اقامتگاه - اقامتگاه یاب</title>
    <link rel="stylesheet" href="~/css/editimages.css" />
</head>
<body>
    <!-- Header Section -->
    <header class="header" id="header">
        <div class="container">
            <div class="header-content">
                <!-- Logo -->
                <div class="logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <h1>اقامت یاب</h1>
                    </a>
                </div>

                <!-- NAVIGATION -->
                <nav class="nav-menu" id="navMenu">
                    <ul>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">خانه</a></li>
                        <li><a asp-area="" asp-controller="Residence" asp-action="Index">اقامتگاه‌ها</a></li>
                        <li><a href="/index.html#about">درباره ما</a></li>
                        <li><a href="/index.html#contact">تماس با ما</a></li>
                    </ul>
                </nav>

                <!-- MOBILE MENU -->
                <button class="mobile-menu-toggle" id="mobileMenuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>
    <!-- Main Content Section -->
    <section class="edit-images-section">
        <div class="container">
            <!-- Page Title and Accommodation Name -->
            <div class="page-header">
                <h1 class="page-title">ویرایش عکس‌های اقامتگاه</h1>
                <p class="accommodation-name" id="accommodationName">@Model.ResidenceName</p>
            </div>

            <!-- Image Slider Section -->
            <form asp-controller="Residence" asp-action="EditResidenceImages" method="post" enctype="multipart/form-data">
                <div class="slider-section">

                    <h2 class="section-subtitle">تصاویر فعلی</h2>
                    <div class="image-slider">
                        <button type="button" class="slider-btn slider-prev" id="sliderPrev">❮</button>
                        <div class="slider-container">
                            <input hidden="true" asp-for="ResidenceName" />
                            <input hidden="true" asp-for="ResidenceId" />
                            <div class="slider-wrapper" id="sliderWrapper">
                                <!-- Images will be inserted here by JavaScript -->
                            </div>
                        </div>
                        <button type="button" class="slider-btn slider-next" id="sliderNext">❯</button>
                    </div>
                </div>

                <!-- Add New Image Section -->
                <div class="add-image-section">
                    <div class="add-image-box">
                        <input type="file"
                               id="imageInput"
                               accept="image/*"
                               style="display: none" />
                        <button type="button" class="btn btn-add-image" id="addImageBtn">
                            <span class="plus-icon">+</span>
                            افزودن عکس جدید
                        </button>
                        <p class="add-image-hint">
                            فقط فایل‌های تصویری (JPG, PNG, GIF) پذیرفته می‌شوند
                        </p>
                    </div>
                </div>
                <button type="submit" onclick="beforeSubmit()" class="btn btn-add-image btn-submit">
                    ذخیره اطلاعات
                </button>
            </form>

        </div>
    </section>

    <!-- Footer Section -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3>درباره ما</h3>
                    <p>
                        اقامت یاب بزرگترین پلتفرم رزرو اقامتگاه در ایران است. ما به شما
                        کمک می‌کنیم بهترین اقامتگاه را برای سفر خود پیدا کنید.
                    </p>
                </div>

                <div class="footer-column">
                    <h3>لینک‌های مفید</h3>
                    <ul>
                        <li><a href="#">درباره ما</a></li>
                        <li><a href="#">تماس با ما</a></li>
                        <li><a href="#">قوانین و مقررات</a></li>
                        <li><a href="#">حریم خصوصی</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h3>پشتیبانی</h3>
                    <ul>
                        <li><a href="#">راهنمای رزرو</a></li>
                        <li><a href="#">سوالات متداول</a></li>
                        <li><a href="#">میزبان شوید</a></li>
                        <li><a href="#">تماس با پشتیبانی</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="social-icons">
                        <a href="instagram.com" class="social-icon">
                            <img src="~/images/outline-instagram-logo_svgstack_com_4721767299818.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="twitter.com" class="social-icon">
                            <img src="~/images/outline-x-vector-logo_svgstack_com_5671767299843.svg"
                                 alt="twitter"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="facebook.com" class="social-icon">
                            <img src="~/images/facebook-icon_svgstack_com_5631767299831.svg"
                                 alt="facebook"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="linkdin.com" class="social-icon">
                            <img src="~/images/linkedin-logo-icon_svgstack_com_3961767299854.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; ۱۴۰۳ اقامت یاب. تمامی حقوق محفوظ است.</p>
            </div>
        </div>
    </footer>
    <script>
        const accommodationData = {
        name: "@Html.Raw(Model.ResidenceName)",
        images: @Html.Raw(Json.Serialize(Model.ExistingImages))
        };
    </script>

    <script src="~/js/editresidenceiamges.js"></script>
</body>
</html>
