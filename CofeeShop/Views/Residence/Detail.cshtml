@model ResidenceDetailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>اقامت یاب</title>
    <link rel="stylesheet" href="/css/accommodation.css" />
</head>
<body>
    <!-- HEADER -->
    <header class="header" id="header">
        <div class="container">
            <div class="header-content">
                <!-- Logo -->
                <div class="logo">
                    <a href="/index.html"><h1>اقامت یاب</h1></a>
                </div>

                <!-- NAVIGATION -->
                <nav class="nav-menu" id="navMenu">
                    <ul>
                        <li><a href="/index.html">خانه</a></li>
                        <li><a href="/index.html#accommodations">اقامتگاه‌ها</a></li>
                        <li><a href="/index.html#about">درباره ما</a></li>
                        <li><a href="/index.html#contact">تماس با ما</a></li>
                    </ul>
                </nav>

                <!-- MOBILE MENU -->
                <button class="mobile-menu-toggle" id="mobileMenuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ACCOMMODATION -->
    <section class="accommodation-hero">
        <div class="container">
            <h1 class="accommodation-title">@Model.Name</h1>
            <div class="accommodation-location-icon">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.5"
                         stroke="currentColor"
                         class="accommodations-icones">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                </span>
                <p class="accommodation-location">@Model.City > @Model.Street > @Model.PostalCode</p>
            </div>
            <div class="hero-meta">
                <span class="meta-item">ظرفیت: @Model.Capacity نفر</span>
                <span class="meta-item @(Model.IsActive ? "active" : "inactive")" id="status-btn">
                    @(Model.IsActive ? "فعال" : "غیرفعال")
                </span>
                <span class="meta-item">⭐ @Model.Stars (@Model.CountRate نظر)</span>
            </div>
            <div class="price-display">
                <span class="price-amount">@Model.Price تومان</span>
                <span class="price-label">هر شب</span>
            </div>
        </div>
    </section>

    <!-- PHOTOS -->
    <section class="image-slider-section">
        <div class="container">
            <div class="slider-container">
                <button class="slider-btn prev-btn" id="prevBtn">❯</button>
                <div class="slider-wrapper">
                    <div class="slides" id="slides">
                        <div class="slide active">
                            <img src="~/residence_images/@Model.MainImage"
                                 alt="ویلای لوکس شمال" />
                        </div>
                        @foreach (var item in Model.ImageNames)
                        {
                            <div class="slide">
                                <img src="~/residence_images/otherImages/@item"
                                     alt="نمای داخلی" />
                            </div>
                        }
                    </div>
                </div>
                <button class="slider-btn next-btn" id="nextBtn">❮</button>
            </div>
            <div class="slider-dots" id="sliderDots"></div>
        </div>
    </section>

    <!-- MAIN INFORMATION -->
    <section class="main-content">
        <div class="container">
            <div class="content-layout">
                <!-- DETAIL -->
                <div class="details-column">
                    <!--  MOBILE -->
                    <div class="booking-box mobile-booking">
                        <h3>رزرو اقامتگاه</h3>
                        <div class="booking-form">
                            <div class="date-row">
                                <div class="input-group">
                                    <label>تاریخ ورود</label>
                                    <input type="date" id="checkInMobile" class="date-input" />
                                </div>
                                <div class="input-group">
                                    <label>تاریخ خروج</label>
                                    <input type="date" id="checkOutMobile" class="date-input" />
                                </div>
                            </div>
                            <div class="calculation-box">
                                <div class="calc-row">
                                    <span>تعداد شب‌ها:</span>
                                    <span class="nights-value" id="nightsMobile">-</span>
                                </div>
                                <div class="calc-row total">
                                    <span>قیمت کل:</span>
                                    <span class="total-value" id="totalMobile">-</span>
                                </div>
                            </div>
                            <button class="btn-reserve" onclick="handleReservation()">
                                رزرو قطعی
                            </button>
                            <p class="note">هنوز پرداختی انجام نمی‌شود</p>
                        </div>
                    </div>

                    <!-- EXP -->
                    <div class="section-box">
                        <h2 class="section-title">درباره این اقامتگاه</h2>
                        <p class="description-text">
                            @Model.Description

                        </p>
                        <p class="description-text">
                            @foreach (var item in Model.Options)
                            {
                            <p>@item.OptionDescription</p>
                            }
                        </p>
                    </div>

                    <!-- ADDRESS -->
                    <div class="section-box">
                        <h2 class="section-title">آدرس و موقعیت</h2>
                        <div class="accommodation-location-icon2">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.5"
                                     stroke="currentColor"
                                     class="accommodations-icones">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                </svg>
                            </span>
                            <p class="accommodation-location">@Model.City > @Model.Street</p>
                        </div>
                    </div>

                    <!-- FACILITI -->
                    <div class="section-box">
                        <h2 class="section-title">امکانات و تجهیزات</h2>
                        <div class="amenities-grid">
                            @foreach (var item in Model.Options)
                            {
                                <div class="amenity-item">
                                    <span class="amenity-icon">⭕</span>
                                    <span>@item.OptionName</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ROLES -->
                    <div class="section-box">
                        <h2 class="section-title">قوانین و مقررات</h2>
                        <div class="rules-grid">
                            <div class="rule-item">
                                <h4>ساعت ورود و خروج</h4>
                                <ul>
                                    <li>ورود: از ساعت 14:00</li>
                                    <li>خروج: تا ساعت 12:00</li>
                                </ul>
                            </div>
                            <div class="rule-item">
                                <h4>مهمانان</h4>
                                <ul>
                                    <li>حداکثر ظرفیت: 8 نفر</li>
                                    <li>ورود کودکان: مجاز</li>
                                </ul>
                            </div>
                            <div class="rule-item">
                                <h4>محدودیت‌ها</h4>
                                <ul>
                                    <li>ممنوعیت سیگار در داخل</li>
                                    <li>حیوانات خانگی با هماهنگی</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- RATING -->
                    <div class="section-box">
                        <h2 class="section-title">نظرات مهمانان</h2>
                        <div class="rating-summary">
                            <div class="rating-badge">
                                <span class="rating-number">@Model.Stars</span>
                                @* <div class="rating-stars">⭐⭐⭐⭐⭐</div> *@
                                <span class="rating-count">از @Model.CountRate نظر</span>
                            </div>
                        </div>

                        <div class="reviews-list">
                            @foreach (var item in Model.Comments)
                            {
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="reviewer">
                                            <span class="reviewer-name">@item.Name</span>
                                            <span class="review-date">@item.Date</span>
                                        </div>
                                            <div class="review-rating">@(new string('⭐', item.Rate))</div>                                    </div>
                                    <p class="review-text">
                                        @item.CommentDescription
                                    </p>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <!-- BOX RESERVE -->
                <div class="booking-column">
                    <div class="booking-box desktop-booking">
                        <h3>رزرو اقامتگاه</h3>
                        <div class="price-header">
                            <span class="price">@Model.Price تومان</span>
                            <span class="per-night">/ هر شب</span>
                        </div>

                        <div class="booking-form">
                            <div class="date-row">
                                <div class="input-group">
                                    <label>تاریخ ورود</label>
                                    <input type="date" id="checkIn" class="date-input" />
                                </div>
                                <div class="input-group">
                                    <label>تاریخ خروج</label>
                                    <input type="date" id="checkOut" class="date-input" />
                                </div>
                            </div>

                            <div class="calculation-box">
                                <div class="calc-row">
                                    <span>قیمت هر شب:</span>
                                    <span>@Model.Price تومان</span>
                                </div>
                                <div class="calc-row">
                                    <span>تعداد شب‌ها:</span>
                                    <span class="nights-value" id="nights">-</span>
                                </div>
                                <div class="divider"></div>
                                <div class="calc-row total">
                                    <span>قیمت کل:</span>
                                    <span class="total-value" id="total">-</span>
                                </div>
                            </div>

                            <button class="btn-reserve" onclick="handleReservation()">
                                رزرو قطعی
                            </button>
                            <p class="note">هنوز پرداختی انجام نمی‌شود</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3>درباره ما</h3>
                    <p>
                        اقامت یاب بزرگترین پلتفرم رزرو اقامتگاه در ایران است. ما به شما
                        کمک می‌کنیم بهترین اقامتگاه را برای سفر خود پیدا کنید.
                    </p>
                </div>

                <div class="footer-column">
                    <h3>لینک‌های مفید</h3>
                    <ul>
                        <li><a href="#">درباره ما</a></li>
                        <li><a href="#">تماس با ما</a></li>
                        <li><a href="#">قوانین و مقررات</a></li>
                        <li><a href="#">حریم خصوصی</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h3>پشتیبانی</h3>
                    <ul>
                        <li><a href="#">راهنمای رزرو</a></li>
                        <li><a href="#">سوالات متداول</a></li>
                        <li><a href="#">میزبان شوید</a></li>
                        <li><a href="#">تماس با پشتیبانی</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="social-icons">
                        <a href="instagram.com" class="social-icon">
                            <img src="~/images/outline-instagram-logo_svgstack_com_4721767299818.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="twitter.com" class="social-icon">
                            <img src="~/images/outline-x-vector-logo_svgstack_com_5671767299843.svg"
                                 alt="twitter"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="facebook.com" class="social-icon">
                            <img src="~/images/facebook-icon_svgstack_com_5631767299831.svg"
                                 alt="facebook"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="linkdin.com" class="social-icon">
                            <img src="~/images/linkedin-logo-icon_svgstack_com_3961767299854.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; ۱۴۰۳ اقامت یاب. تمامی حقوق محفوظ است.</p>
            </div>
        </div>
    </footer>

    <!-- SCRIPT -->
    <script src="~/js/accommodation.js"></script>
</body>
</html>
