@model AddResidenceViewModel

@{
    Layout = "_ResidenceLayout";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>افزودن اقامتگاه - اقامتگاه یاب</title>
    <link rel="stylesheet" href="~/css/addaccommodation.css" />
</head>
<body>
    <!-- Header Section -->
    <!-- Main section -->
    <section class="accommodation_section">
        <div class="container">
            <div class="card">
                <div class="flex-manage">
                    <h2>افزودن اقامتگاه</h2>
                    <a class="btn-outline" href="editimages.html">افزودن عکس</a>
                </div>
                <form asp-controller="Residence" asp-action="AddResidence" method="post" id="mgmt-form" class="mt-4">
                    <div class="form-group">
                        <label>نام</label>
                        <input asp-for="ResidenceName" type="text" />
                    </div>
                    <div class="form-group">
                        <label>آدرس</label>
                        <input asp-for="Street" type="text" />
                    </div>
                    <div class="form-row">
                        <div class="form-group city-select">
                            <label>شهر</label>

                            <input
                                asp-for="CityName"
                                type="text"
                                id="cityInput"
                                placeholder="نام شهر را جستجو کنید"
                                autocomplete="off" />

                            <ul id="cityList" class="city-list"></ul>
                        </div>

                        <div class="form-group">
                            <label>نوع اقامتگاه</label>
                            <input asp-for="Type" type="text" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>کد پستی</label>
                            <input asp-for="PostalCode" type="text" />
                        </div>
                        <div class="form-group">
                            <label>قیمت به ازای هر شب</label>
                            <input asp-for="PricePerDate" type="number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>توضیحات</label>
                        <textarea asp-for="Description" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label>امکانات</label>
                        <div class="checkbox-box">
                            @{
                                var options = ViewData["Options"] as List<string>;
                            }
                            @for (int i = 0; i < options.Count; i++)
                            {
                                <div class="checkbox-container">
                                    <input class="checkbox" type="checkbox" name="options" id="checkboxes[@i]" value="@options[i]"/>
                                    <label for="checkboxes[@i]" class="checkbox-label">@options[i]</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>وضعیت</label>
                            <select asp-for="IsActive">
                                <option value="true">فعال</option>
                                <option value="false">غیرفعال</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>ظرفیت</label>
                            <input asp-for="Capacity" type="number" />
                        </div>
                    </div>
                    <button type="submit" class="btn-reserve">ذخیره اطلاعات</button>
                </form>
            </div>
        </div>
    </section>
    <!-- Footer Section -->

    <script src="~/js/addaccommodation.js"></script>
</body>
</html>
