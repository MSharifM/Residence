<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>رزرو اقامتگاه - بهترین اقامتگاه‌های ایران</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/fontawesome/css/all-fonts.min.css" />
</head>
<body class="font-Dana-regular bg-gray-100 dark:bg-zinc-800">
    <!-- HEADER DESCTOP -->
    
    <!-- MAIN -->
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <!-- About Column -->
                <div class="footer-column">
                    <h3>درباره ما</h3>
                    <p>
                        اقامت یاب بزرگترین پلتفرم رزرو اقامتگاه در ایران است. ما به شما
                        کمک می‌کنیم بهترین اقامتگاه را برای سفر خود پیدا کنید.
                    </p>
                </div>

                <!-- Links Column -->
                <div class="footer-column">
                    <h3>لینک‌های مفید</h3>
                    <ul>
                        <li><a href="#">درباره ما</a></li>
                        <li><a href="#">تماس با ما</a></li>
                        <li><a href="#">قوانین و مقررات</a></li>
                        <li><a href="#">حریم خصوصی</a></li>
                    </ul>
                </div>

                <!-- Support Column -->
                <div class="footer-column">
                    <h3>پشتیبانی</h3>
                    <ul>
                        <li><a href="#">راهنمای رزرو</a></li>
                        <li><a href="#">سوالات متداول</a></li>
                        <li><a href="#">میزبان شوید</a></li>
                        <li><a href="#">تماس با پشتیبانی</a></li>
                    </ul>
                </div>

                <!-- Social Media Column -->
                <div class="footer-column">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="social-icons">
                        <a href="instagram.com" class="social-icon">
                            <img src="/images/outline-instagram-logo_svgstack_com_4721767299818.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="twitter.com" class="social-icon">
                            <img src="/images/outline-x-vector-logo_svgstack_com_5671767299843.svg"
                                 alt="twitter"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="facebook.com" class="social-icon">
                            <img src="/images/facebook-icon_svgstack_com_5631767299831.svg"
                                 alt="facebook"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="linkdin.com" class="social-icon">
                            <img src="/images/linkedin-logo-icon_svgstack_com_3961767299854.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="footer-bottom">
                <p>Copyright © 2023 Aghamtgah Yab. All rights reserved</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>