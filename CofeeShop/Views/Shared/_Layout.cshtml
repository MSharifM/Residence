<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>رزرو اقامتگاه - بهترین اقامتگاه‌های ایران</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all-fonts.min.css" />
</head>
<body class="font-Dana-regular bg-gray-100 dark:bg-zinc-800">
    <!-- HEADER DESCTOP -->
    <header class="header" id="header">
        <div class="container">
            <div class="header-content">
                <!-- Logo -->
                <div class="logo">
                    <h1>اقامت یاب</h1>
                </div>

                <!-- Desktop Navigation -->
                <nav class="nav-menu" id="navMenu">
                    <ul>
                        <li><a href="#" class="active">خانه</a></li>
                        <li><a href="#accommodations">اقامتگاه‌ها</a></li>
                        <li><a href="#about">درباره ما</a></li>
                        <li><a href="#contact">تماس با ما</a></li>
                    </ul>
                </nav>

                <!-- Auth Buttons -->
                <div class="auth-buttons" id="authButtons">
                    <a asp-controller="Account" asp-action="Authentication" class="login-btn">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor"
                             class="login-icone">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                        </svg>

                        <span class="login-title">ورود | ثبت نام</span>
                    </a>
                </div>
                <!-- login members -->
                <div class="user-menu-wrapper" id="userMenuWrapper" style="display: none">
                    <button class="user-menu-button" id="userMenuButton">
                        <span class="user-name">حساب کاربری</span>
                        <span class="arrow-icon">▼</span>
                    </button>
                    <div class="user-menu-dropdown" id="userMenuDropdown">
                        <a asp-area="UserPanel" asp-action="Index" class="menu-item">
                            <span>اطلاعات حساب کاربری</span>
                        </a>
                        <a href="#" class="menu-item">
                            <span>سفرهای من</span>
                        </a>
                        <a href="#" class="menu-item">
                            <span>پرسش‌های متداول</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm"></form>
                        <a class="menu-item logout-item" id="logoutBtn">
                            <span>خروج از حساب کاربری</span>
                        </a>
                    </div>
                </div>

                <!-- Mobile Menu Toggle -->
                <button class="mobile-menu-toggle" id="mobileMenuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>
    <!-- MAIN -->
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <!-- About Column -->
                <div class="footer-column">
                    <h3>درباره ما</h3>
                    <p>
                        اقامت یاب بزرگترین پلتفرم رزرو اقامتگاه در ایران است. ما به شما
                        کمک می‌کنیم بهترین اقامتگاه را برای سفر خود پیدا کنید.
                    </p>
                </div>

                <!-- Links Column -->
                <div class="footer-column">
                    <h3>لینک‌های مفید</h3>
                    <ul>
                        <li><a href="#">درباره ما</a></li>
                        <li><a href="#">تماس با ما</a></li>
                        <li><a href="#">قوانین و مقررات</a></li>
                        <li><a href="#">حریم خصوصی</a></li>
                    </ul>
                </div>

                <!-- Support Column -->
                <div class="footer-column">
                    <h3>پشتیبانی</h3>
                    <ul>
                        <li><a href="#">راهنمای رزرو</a></li>
                        <li><a href="#">سوالات متداول</a></li>
                        <li><a href="#">میزبان شوید</a></li>
                        <li><a href="#">تماس با پشتیبانی</a></li>
                    </ul>
                </div>

                <!-- Social Media Column -->
                <div class="footer-column">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="social-icons">
                        <a href="instagram.com" class="social-icon">
                            <img src="/images/outline-instagram-logo_svgstack_com_4721767299818.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="twitter.com" class="social-icon">
                            <img src="/images/outline-x-vector-logo_svgstack_com_5671767299843.svg"
                                 alt="twitter"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="facebook.com" class="social-icon">
                            <img src="/images/facebook-icon_svgstack_com_5631767299831.svg"
                                 alt="facebook"
                                 width="32"
                                 height="32" />
                        </a>
                        <a href="linkdin.com" class="social-icon">
                            <img src="/images/linkedin-logo-icon_svgstack_com_3961767299854.svg"
                                 alt="Instagram"
                                 width="32"
                                 height="32" />
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="footer-bottom">
                <p>Copyright © 2023 Aghamtgah Yab. All rights reserved</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>