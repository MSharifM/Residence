@model HomePageViewModel

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>رزرو اقامتگاه - بهترین اقامتگاه‌های ایران</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/fontawesome/css/all-fonts.min.css" />
</head>
<body>
    <!-- Header Section -->
    <!-- HERO SECTION -->
    <section class="hero">
        <div class="hero-overlay">
            <div class="hero-content">
                <h1 class="hero-title">اقامتگاه‌های منحصربه‌فرد را رزرو کنید</h1>
                <p class="hero-subtitle">
                    اقامتگاه‌های منحصر به فرد ما در سرتاسر ایران آماده‌اند تا لحظاتی
                    فراموش‌نشدنی برای شما بسازند. از خانه‌های ساحلی آرامش‌بخش گرفته تا
                    ویلاهای لوکس در دل طبیعت، با بهترین قیمت و امکانات کامل، سفر خود را
                    به خاطره‌ای شیرین تبدیل کنید. همین حالا رزرو کنید و آرامش و راحتی را
                    در هر مقصد تجربه کنید.
                </p>
            </div>
        </div>
    </section>

    <!-- Accommodations Listing Section -->
    <section class="accommodations" id="accommodations">
        <div class="container">
            <h2 class="section-title">اقامتگاه‌های پیشنهادی</h2>
            <div class="accommodations-grid" id="accommodationsGrid">
                <partial name="_BoxResidenceView" model="@((Residences: Model.SuggestResidencesList, Category: "accommodation"))" />
            </div>
        </div>
    </section>

    <!-- Popular Accommodations Section -->
    <section class="popular-accommodations">
        <div class="container">
            <div class="container-sliders">
                <h2 class="section-title">محبوب‌ ترین اقامتگاه‌ها</h2>
                <div class="flex-sliders">
                    <span class="sliders next">
                        <i class="fas fa-chevron-right"></i>
                    </span>
                    <span class="sliders prev">
                        <i class="fas fa-chevron-left"></i>
                    </span>
                </div>
            </div>
            <div class="popular-grid" id="popularGrid">
                <partial name="_BoxResidenceView" model="@((Residences: Model.PopularResidencesList, Category: "popular"))" />
            </div>
        </div>
    </section>

    <!-- Recommended Section -->
    <section class="recommended">
        <div class="container">
            <h2 class="section-title">پیشنهاد ویژه برای شما</h2>
            <div class="recommended-grid" id="recommendedGrid">
                <!-- Cards will be generated by JavaScript -->
            </div>
        </div>
    </section>

    <!-- About Accommodations Section -->
    <section class="about-accommodations" id="about">
        <div class="container">
            <h2 class="section-title">درباره اقامتگاه‌ها</h2>
            <p class="about-text">
                اقامتگاه‌ها مکان‌های منحصربه‌فردی هستند که تجربه‌ای متفاوت از هتل‌های
                معمولی را به شما ارائه می‌دهند. با انتخاب اقامتگاه، می‌توانید در فضایی
                دنج و خصوصی، لحظات به‌یادماندنی را با عزیزان خود بسازید.
            </p>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🏡</div>
                    <h3>اقامتگاه‌های متنوع</h3>
                    <p>از ویلاهای لوکس تا کلبه‌های سنتی</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💰</div>
                    <h3>قیمت مناسب</h3>
                    <p>بهترین قیمت را با ما تجربه کنید</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⭐</div>
                    <h3>کیفیت تضمین شده</h3>
                    <p>همه اقامتگاه‌ها بازرسی شده‌اند</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h3>رزرو امن</h3>
                    <p>پرداخت و رزرو کاملا ایمن</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Text Content Section -->
    <section class="text-content">
        <div class="container">
            <div class="text-content-inner">
                <h2>چرا اقامت یاب؟</h2>
                <p>
                    ما در اقامت یاب، تلاش می‌کنیم بهترین تجربه اقامتی را برای شما
                    فراهم کنیم. با بیش از ۵۰۰۰ اقامتگاه در سراسر ایران، از شمال سرسبز تا
                    جنوب گرم، از شرق تاریخی تا غرب کوهستانی، ما گزینه‌های متنوعی برای هر
                    سلیقه و بودجه‌ای داریم.
                </p>
                <p>
                    تیم ما با دقت تمام، هر اقامتگاه را بررسی و تایید می‌کند تا از کیفیت
                    بالای خدمات اطمینان حاصل شود. رزرو آنلاین، پشتیبانی ۲۴ ساعته و ضمانت
                    بازگشت وجه از ویژگی‌های خدمات ما هستند.
                </p>
            </div>
        </div>
    </section>

    <!-- Exc Accommodations Section -->
    <section class="exclusive-accommodations">
        <div class="container">
            <h2 class="section-title">اقامتگاه‌های لوکس و اختصاصی</h2>
            <p class="section-subtitle">
                تجربه‌ای بی‌نظیر از اقامت در بهترین اقامتگاه‌های ایران
            </p>
            <div class="exclusive-grid" id="exclusiveGrid">
                <partial name="_BoxResidenceView" model="@((Residences: Model.LuxResidencesList, Category: "exclusive"))" />
            </div>
            <div class="cta-center">
                <button class="btn btn-cta">مشاهده همه اقامتگاه‌های لوکس</button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <!-- SCRIPT -->
    <script src="/js/script.js"></script>
</body>
</html>
