@{
    Layout = "_ResidenceLayout";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>پرسش های متداول - اقامتگاه یاب</title>
    <link rel="stylesheet" href="~/fontawesome/css/all-fonts.min.css" />
    <link rel="stylesheet" href="~/css/aboutus.css" />
</head>
<body>
    <!-- Header Section -->
    <!-- About Us Content -->
    <section class="about-us">
        <div class="container">
            <h1 class="title">درباره ما</h1>
            <p class="intro">
                سایت ما با هدف ساده‌سازی تجربه سفر و پیدا کردن بهترین اقامتگاه‌ها برای
                شما راه‌اندازی شد. ما می‌خواهیم هر سفر، چه کاری و چه تفریحی، به
                خاطره‌ای دلنشین و بدون دغدغه تبدیل شود.
            </p>

            <!-- Mission -->
            <div class="section">
                <h2>ماموریت ما</h2>
                <p>
                    ماموریت ما ارائه پلتفرمی امن، سریع و هوشمند برای رزرو اقامتگاه‌ها
                    است. ما معتقدیم هر سفر شایسته بهترین تجربه است و هدف ما کاهش استرس
                    کاربران در جستجو و رزرو اقامتگاه می‌باشد. با استفاده از الگوریتم‌های
                    پیشرفته، بهترین گزینه‌ها را بر اساس نیازهای شما نمایش می‌دهیم و
                    همواره در تلاش هستیم خدمات خود را بهبود دهیم.
                </p>
            </div>

            <!-- Vision -->
            <div class="section">
                <h2>چشم‌انداز</h2>
                <p>
                    چشم‌انداز ما تبدیل شدن به اولین انتخاب کاربران برای پیدا کردن و رزرو
                    اقامتگاه در سطح کشور و بین‌الملل است. ما می‌خواهیم با ترکیب فناوری و
                    تجربه کاربری، سفرهای به یادماندنی را برای همه رقم بزنیم. همچنین قصد
                    داریم با همکاری با میزبانان معتبر، شبکه‌ای قوی از اقامتگاه‌های متنوع
                    و استاندارد فراهم کنیم.
                </p>
            </div>

            <!-- History -->
            <div class="section">
                <h2>تاریخچه</h2>
                <p>
                    این پروژه در سال 1404 آغاز شد و با تلاش یک تیم پرشور و متخصص، در مدت
                    کمتر از یک سال به یک پلتفرم کامل تبدیل شد. از همان ابتدا هدف ما
                    ارائه تجربه کاربری عالی، رابط کاربری ساده و پشتیبانی ۲۴ ساعته بود.
                    با گذشت زمان و دریافت بازخورد کاربران، امکانات جدیدی مانند جستجوی
                    پیشرفته، فیلترهای هوشمند و سیستم پیام‌رسانی داخلی اضافه شد.
                </p>
            </div>

            <!-- Values -->
            <div class="section">
                <h2>ارزش‌ها و اصول ما</h2>
                <ul>
                    <li>شفافیت و صداقت در ارائه اطلاعات اقامتگاه‌ها.</li>
                    <li>امنیت و حفظ حریم شخصی کاربران.</li>
                    <li>پشتیبانی فعال و پاسخگو برای حل سریع مشکلات.</li>
                    <li>تجربه کاربری ساده، زیبا و بدون دردسر.</li>
                    <li>توسعه مداوم و بروزرسانی خدمات بر اساس بازخورد کاربران.</li>
                </ul>
            </div>

            <!-- Team -->
            <div class="section">
                <h2>تیم ما</h2>
                <p>
                    تیم ما متشکل از برنامه‌نویسان، طراحان رابط کاربری، متخصصین بازاریابی
                    و پشتیبانی است. ما با همکاری و شور و اشتیاق، تلاش می‌کنیم هر روز
                    خدمات بهتری ارائه کنیم و به شما در داشتن سفرهای خاطره‌انگیز کمک
                    کنیم.
                </p>
                <p>
                    هر عضو تیم ما متعهد است که تجربه کاربری را در اولویت قرار دهد و با
                    نگاه به آینده، همیشه به دنبال راه‌حل‌های نوآورانه و کارآمد برای شما
                    باشد.
                </p>
            </div>

            <!-- Contact -->
            <div class="section contact">
                <h2>تماس با ما</h2>
                <p>
                    اگر سوال یا پیشنهادی دارید، می‌توانید با تیم ما از طریق ایمیل
                    <a href="mailto:info@example.com">info@aghamtyab.com</a> تماس
                    بگیرید. همچنین شبکه‌های اجتماعی ما فعال هستند و پاسخگویی به پیام‌های
                    شما اولویت ماست.
                    <br />
                    <br />
                    <span>شماره تماس: <a href="tel:09370509408">09370509408</a></span>
                </p>
            </div>
        </div>
    </section>

    <!-- Footer Section -->

</body>
</html>
